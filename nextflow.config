docker.enabled = true

params {
    help             = false

    // Input mode selects which TSV samplesheet is used and how MODULE1/MODULE2 run:
    //   from_reads     - sample_name, reads1, reads2                   -> MEGAHIT assembly + BWA-MEM mapping
    //   from_assembly  - sample_name, assembly, reads1, reads2         -> skip MEGAHIT, still run BWA-MEM mapping
    //   from_bam       - sample_name, assembly, bam                   -> skip both; reheader the given bam
    //   from_orfs      - sample_name, assembly, bam, orfs_faa, orfs_bed -> skip both (like from_bam) AND skip
    //                                                                      MODULE2 ORF prediction (FragGeneScanRs)
    input_mode = "from_reads"

    from_reads_tsv    = './test/data/from_reads.tsv'
    from_assembly_tsv = null
    from_bam_tsv      = null
    from_orfs_tsv     = null

    nslots           = 16
    output_dir       = './test/mg-clust-output/'
    full_output      = true
    // publishDir mode for every module: copy | symlink | rellink | link | move
    publish_mode     = "copy"
    stop_at_module   = 6
    skip_tax_annot   = false
    skip_fun_annot   = false
    maxForks = 3

    // MODULE1
    assem_preset    = "meta-sensitive"
    min_contig_len  = 250
    min_seq         = 5

    // MODULE2
    train_file_name = "illumina_1"

    // MODULE3
    min_orf_len  = 60
    clust_thres     = 0.7
    clust_cov_len   = 0.85

    // MODULE4
    gtdb        = "${System.getenv('HOME')}/.mg-clust/db/gtdb/gtdb"
    lca_mode    = 3
    sensitivity = 4.0
    tax_lineage = 1

    // MODULE5
    hmm_db       = "${System.getenv('HOME')}/.mg-clust/db/ko/ko_profiles.hmm"
    db_mode      = "ko"
    ko_list      = "${System.getenv('HOME')}/.mg-clust/db/ko/ko_list.tsv"
    evalue_thres = 1e-3
    edge_tol     = 3
    relax_evalue_factor = 100

}

process {
    // Per-sample modules: one task per sample, up to params.maxForks at a time,
    // each task using params.nslots threads. maxForks applies per process, not
    // pipeline-wide, so these modules overlap with each other and with MODULE3 --
    // the pipeline total is not capped at maxForks * nslots.
    withName: /MODULE1.*/ {
        maxForks = params.maxForks
        cpus     = params.nslots
    }
    withName: /MODULE2.*/ {
        maxForks = params.maxForks
        cpus     = params.nslots
    }
    withName: MODULE4 {
        maxForks = params.maxForks
        cpus     = params.nslots
        containerOptions = "--volume ${System.getenv('HOME')}/.mg-clust:${System.getenv('HOME')}/.mg-clust"
    }
    withName: MODULE5 {
        maxForks = params.maxForks
        cpus     = params.nslots
        containerOptions = "--volume ${System.getenv('HOME')}/.mg-clust:${System.getenv('HOME')}/.mg-clust"
    }

    // Whole-dataset modules: a single task over all samples collected together, so
    // give it the whole budget the per-sample modules share rather than a single
    // sample's slice.
    // MODULE3 is NOT exclusive: it, MODULE4 and MODULE5 all hang off MODULE2 as
    // independent DAG branches and can run concurrently. On the local executor a
    // MODULE3 task claiming every core therefore only starts once the machine is
    // idle, with MODULE4/MODULE5 tasks queued behind it. Only MODULE6 joins every
    // upstream branch and genuinely runs alone.
    withName: MODULE3 {
        maxForks = 1
        cpus     = params.maxForks * params.nslots
    }
    // MODULE6 forwards task.cpus to DuckDB (`SET threads`), so this declaration
    // is what bounds its thread pool -- DuckDB would otherwise size the pool from
    // the host's core count, ignoring whatever this task was allocated.
    withName: MODULE6 {
        maxForks = 1
        cpus     = params.maxForks * params.nslots
    }
}

workflow.onComplete = {
    if (!workflow.success) return

    def intermediateDir = new File("${params.output_dir}/intermediate/module-6")
    if (!intermediateDir.exists()) return // module 6 never ran (e.g. --stop_at_module < 6); nothing to link

    def workablesDir    = new File("${params.output_dir}/workables")
    workablesDir.mkdirs()

    def workablePatterns = [
        ~/contigs_tax_annot\.tsv$/,
        ~/orfs-.*fun_annot\.tsv$/,
        ~/orfs_clust-.*\.tsv$/,
    ]

    intermediateDir.eachFileRecurse { f ->
        if (!f.isFile()) return
        if (workablePatterns.any { pat -> f.name ==~ pat }) {
            def relTarget = workablesDir.toPath().relativize(f.toPath()).toString()
            def linkPath  = new File(workablesDir, f.name).toString()
            ["ln", "-sf", relTarget, linkPath].execute()
        }
    }
}
