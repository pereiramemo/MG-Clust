params {
    help             = false

    // Input mode selects which TSV samplesheet is used and how MODULE1/MODULE2 run:
    //   from_reads     - sample_name, reads1, reads2                     -> MEGAHIT assembly + BWA-MEM mapping
    //   from_assembly  - sample_name, assembly, reads1, reads2           -> skip MEGAHIT, still run BWA-MEM mapping
    //   from_bam       - sample_name, assembly, bam                      -> skip both; reheader the given bam
    //   from_orfs      - sample_name, assembly, bam, orfs_faa, orfs_bed  -> skip both (like from_bam) AND skip
    //                                                                       MODULE2 ORF prediction (FragGeneScanRs)
    input_mode = "from_reads"

    from_reads_tsv    = './test/data/from_reads.tsv'
    from_assembly_tsv = null
    from_bam_tsv      = null
    from_orfs_tsv     = null

    nslots           = 16
    output_dir       = './test/mg-clust-output/'
    full_output      = true
    // publishDir mode for every module: copy | symlink | rellink | link | move
    publish_mode     = "copy"
    stop_at_module   = 6
    skip_tax_annot   = false
    skip_fun_annot   = false
    maxForks = 3
    // Per-sample maxForks under -profile slurm. maxForks exists to protect a single
    // machine; on a cluster the scheduler does that job, so the per-process cap is
    // raised and executor.queueSize becomes the real pipeline-wide throttle.
    maxForks_slurm = 30
    // Threads for the single-task, whole-dataset modules (3 and 6). Kept separate
    // from maxForks so raising cluster concurrency does not inflate their CPU
    // request into something the scheduler can never satisfy. 
    nslots_collected = 24

    // MODULE1
    // Separator between the sample name and the original contig name in contig
    // and ORF IDs, e.g. "<sample>|<contig>". MODULE1 is the only writer of it;
    // every downstream module treats the composed ID as an opaque string and
    // never splits on it. Consumers of the published taxonomy/function tables
    // split on the FIRST occurrence, so a separator that also occurs inside the
    // contig name is fine. Must match the separator already present in any
    // precomputed assembly/BAM/ORF inputs.
    id_sep          = "|"
    assem_preset    = "meta-sensitive"
    min_contig_len  = 250
    min_seq         = 5

    // MODULE2
    train_file_name = "illumina_1"

    // MODULE3
    min_orf_len  = 60
    clust_thres     = 0.7
    clust_cov_len   = 0.85

    // MODULE4
    gtdb        = "${System.getenv('HOME')}/.mg-clust/db/gtdb/gtdb"
    lca_mode    = 3
    sensitivity = 4.0
    tax_lineage = 1

    // MODULE5
    hmm_db       = "${System.getenv('HOME')}/.mg-clust/db/ko/ko_profiles.hmm"
    db_mode      = "ko"
    ko_list      = "${System.getenv('HOME')}/.mg-clust/db/ko/ko_list.tsv"
    evalue_thres = 1e-3
    edge_tol     = 3
    tighten_evalue_factor = 100

}

process {
    // Per-sample modules: one task per sample, up to params.maxForks at a time,
    // each task using params.nslots threads. maxForks applies per process, not
    // pipeline-wide, so these modules overlap with each other and with MODULE3 --
    // the pipeline total is not capped at maxForks * nslots.
    //
    // `memory` lives here rather than in the slurm profile for the same reason `cpus`
    // does: it is the single source of truth the modules read back via task.memory, so
    // the tools can be told the budget instead of auto-sizing from the node's total RAM.
    // It scales with task.attempt, which only ever exceeds 1 under -profile slurm, where
    // errorStrategy retries an OOM-killed task with a bigger slice.
    withName: /MODULE1.*/ {
        maxForks = params.maxForks
        cpus     = params.nslots
        // MEGAHIT's SdBG dominates; bwa index and samtools sort (no -m) add on top.
        memory   = { 60.GB * task.attempt }
    }
    withName: /MODULE2.*/ {
        maxForks = params.maxForks
        cpus     = params.nslots
        // FragGeneScanRs + bedtools coverage -sorted, which streams instead of
        // loading the BAM into memory.
        memory   = { 16.GB * task.attempt }
    }
    withName: MODULE4 {
        maxForks = params.maxForks
        cpus     = params.nslots
        // mmseqs taxonomy prefilter against GTDB -- the biggest per-sample consumer.
        memory   = { 64.GB * task.attempt }
        containerOptions = "--volume ${System.getenv('HOME')}/.mg-clust:${System.getenv('HOME')}/.mg-clust"
    }
    withName: MODULE5 {
        maxForks = params.maxForks
        cpus     = params.nslots
        // pyhmmer prefetches the whole ORF set into a DigitalSequenceBlock; the HMM
        // file itself is streamed, not loaded whole.
        memory   = { 32.GB * task.attempt }
        containerOptions = "--volume ${System.getenv('HOME')}/.mg-clust:${System.getenv('HOME')}/.mg-clust"
    }

    // Whole-dataset modules: a single task over all samples collected together, so
    // a greater budget of cpus is assigned (i.e., nslots_collected).
    withName: MODULE3 {
        maxForks = 1
        cpus     = params.nslots_collected
        // mmseqs cluster over every sample's ORFs at once; scales with total ORF count.
        memory   = { 120.GB * task.attempt }
    }
    // MODULE6 forwards task.cpus to DuckDB (`SET threads`), so this declaration
    // is what bounds its thread pool -- DuckDB would otherwise size the pool from
    // the host's core count, ignoring whatever this task was allocated.
    withName: MODULE6 {
        maxForks = 1
        cpus     = params.nslots_collected
        // DuckDB hash joins over the concatenated per-sample coverage tables.
        memory   = { 32.GB * task.attempt }
    }
}

profiles {

    // Default: single machine, Docker. Applied automatically when no -profile is given,
    standard {
        docker.enabled   = true
        process.executor = 'local'
    }

    // SLURM cluster with Apptainer.
    slurm {
        docker.enabled        = false   // also covers `-profile standard,slurm`
        apptainer.enabled     = true
        apptainer.cacheDir    = "${System.getenv('HOME')}/.mg-clust/apptainer"
        apptainer.pullTimeout = '2 h'

        process.executor = 'slurm'

        executor {
            // The scheduler does the queueing now, so per-process maxForks is no longer
            // the throttle -- queueSize caps how many jobs Nextflow keeps in flight.
            queueSize       = 50
            submitRateLimit = '10/1min'
        }

        process {
            // OOM (137) and walltime kills are the likeliest cluster failures; retry
            // with both a longer wall clock and more memory (task.attempt scales the
            // `memory` directives in the shared process block above).
            errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
            maxRetries    = 2
            time          = { 8.h * task.attempt }

            withName: /MODULE1.*/ { 
                maxForks = params.maxForks_slurm; 
                time = { 24.h * task.attempt } }
            withName: /MODULE2.*/ { 
                maxForks = params.maxForks_slurm }
            withName: MODULE3     { 
                time = { 48.h * task.attempt } }

            // --bind is the Apptainer equivalent of Docker's --volume;
            // "--bind <path>" binds path -> the same path inside the container. These
            // override the Docker-syntax containerOptions in the shared process block.
            withName: MODULE4 {
                maxForks = params.maxForks_slurm
                time     = { 24.h * task.attempt }
                containerOptions = "--bind ${System.getenv('HOME')}/.mg-clust"
            }
            withName: MODULE5 {
                maxForks = params.maxForks_slurm
                time     = { 24.h * task.attempt }
                containerOptions = "--bind ${System.getenv('HOME')}/.mg-clust"
            }
        }
    }
}

workflow.onComplete = {
    if (!workflow.success) return

    def intermediateDir = new File("${params.output_dir}/intermediate/module-6")
    if (!intermediateDir.exists()) return // module 6 never ran (e.g. --stop_at_module < 6); nothing to link

    def workablesDir    = new File("${params.output_dir}/workables")
    workablesDir.mkdirs()

    // Outputs are gzipped (see bin/utils.py gzip_file); the (\.gz)? keeps these
    // matching if compression is ever turned off again.
    def workablePatterns = [
        ~/contigs_tax_annot\.tsv(\.gz)?$/,
        ~/orfs-.*fun_annot\.tsv(\.gz)?$/,
        ~/orfs_clust-.*\.tsv(\.gz)?$/,
    ]

    intermediateDir.eachFileRecurse { f ->
        if (!f.isFile()) return
        if (workablePatterns.any { pat -> f.name ==~ pat }) {
            def relTarget = workablesDir.toPath().relativize(f.toPath()).toString()
            def linkPath  = new File(workablesDir, f.name).toString()
            ["ln", "-sf", relTarget, linkPath].execute()
        }
    }
}
